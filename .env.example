APP_ENV=local
DATABASE_URL=sqlite:///./db/drct_asset.sqlite3.db
DART_API_KEY=your_dart_api_key_here
DART_RAW_DIR=./data/raw/dart
DART_DISCLOSURE_DEFAULT_DAYS=30
DART_PAGE_COUNT=100
# KRX listed-info API key from data.go.kr
# - When sending with requests params: prefer Decoding key
# - When appending directly to URL: Encoding key may be required
KRX_API_SERVICE_KEY=
KRX_API_BASE_URL=https://apis.data.go.kr/1160100/service/GetKrxListedInfoService/getItemInfo
KRX_API_KEY_MODE=encoded
KRX_API_TIMEOUT_SECONDS=15
KRX_API_MAX_PAGES=10
BROKER_APP_KEY=your_broker_app_key_here
BROKER_APP_SECRET=your_broker_app_secret_here
BROKER_ACCOUNT_NO=your_account_no_here
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e2b
LLM_REPORT_BASE_DIR=./reports/company
LLM_TIMEOUT_SECONDS=300
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_INPUT_CHARS=4500
ANALYSIS_MAX_NEWS_LIMIT=100
ANALYSIS_MAX_DISCLOSURE_LIMIT=100
LLM_RETRY_COUNT=1
LLM_CHUNK_SIZE=3
LLM_CHUNK_MAX_OUTPUT_TOKENS=700
LLM_FINAL_MAX_OUTPUT_TOKENS=1500
LLM_MAX_ITEM_SUMMARY_CHARS=120
# LM Studio item-level AI summary
LLM_ITEM_SUMMARY_TIMEOUT_SECONDS=120
LLM_ITEM_SUMMARY_MAX_OUTPUT_TOKENS=700
LLM_ITEM_SUMMARY_RETRY_COUNT=1
AI_SUMMARY_BATCH_NEWS_LIMIT=10
AI_SUMMARY_BATCH_DISCLOSURE_LIMIT=10
REPORT_BASE_DIR=./reports
RAW_DATA_DIR=./data/raw
NEWS_PROVIDER=naver
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
NEWS_DEFAULT_DISPLAY=20
NEWS_DEFAULT_SORT=date
NEWS_RAW_DIR=./data/raw/news

